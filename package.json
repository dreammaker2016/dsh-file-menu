{
  "name": "@z1995418/dsh-file-menu",
  "version": "0.8.1",
  "description": "Codex-style right-click menus for the DeepSeek Harness Web UI: copy/cut/paste/select-all on text, copy path and reveal in the file manager for file chips, copy or open for links.",
  "license": "MIT",
  "author": "dreammaker2016",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-menu",
    "right-click",
    "clipboard",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dreammaker2016/dsh-file-menu.git"
  },
  "homepage": "https://github.com/dreammaker2016/dsh-file-menu#readme",
  "bugs": {
    "url": "https://github.com/dreammaker2016/dsh-file-menu/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
